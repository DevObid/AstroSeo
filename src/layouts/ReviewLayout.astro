---
import { Image, getImage } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import { SITE_URL } from '../consts';

interface Props {
  entry: {
    id: string;
    data: {
      title: string;
      description: string;
      toolName: string;
      category: string;
      pricing: string;
      websiteUrl: string;
      pubDate: Date;
      updatedDate?: Date;
      heroImage?: any;
      heroImageAlt?: string;
      pros: string[];
      cons: string[];
      tags: string[];
      landingStyle?: boolean;
      launchBanner?: string;
      ctaLabel?: string;
      pricingTiers?: { name: string; price: string }[];
      screenshots?: { image: any; caption?: string }[];
    };
  };
}

const { entry } = Astro.props;
const {
  title,
  description,
  toolName,
  category,
  pricing,
  websiteUrl,
  pubDate,
  updatedDate,
  heroImage,
  heroImageAlt,
  pros,
  cons,
  tags,
  landingStyle = false,
  launchBanner,
  ctaLabel,
  pricingTiers = [],
  screenshots = [],
} = entry.data;
const cta = ctaLabel ?? `Visit ${toolName}`;

const screenshotFulls = await Promise.all(
  screenshots.map(async (shot) => {
    const srcWidth = shot.image.width ?? 1600;
    const srcHeight = shot.image.height ?? Math.round(srcWidth * 0.5);
    const targetWidth = Math.min(1600, srcWidth);
    const targetHeight = Math.round((targetWidth / srcWidth) * srcHeight);
    const full = await getImage({ src: shot.image, width: targetWidth, height: targetHeight });
    return full.src;
  })
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Review',
  itemReviewed: {
    '@type': 'SoftwareApplication',
    name: toolName,
    applicationCategory: category,
    url: websiteUrl,
  },
  author: {
    '@type': 'Organization',
    name: 'AppScoutHub',
  },
  datePublished: pubDate.toISOString(),
  ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
  publisher: {
    '@type': 'Organization',
    name: 'AppScoutHub',
    url: SITE_URL,
  },
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'Reviews', item: `${SITE_URL}/reviews` },
    { '@type': 'ListItem', position: 3, name: title, item: `${SITE_URL}/reviews/${entry.id}` },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  image={heroImage?.src}
  type="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  jsonLd={[jsonLd, breadcrumbJsonLd]}
>
  <article class="bg-grid dark:bg-none">
    <div class="mx-auto max-w-3xl px-4 pb-4 pt-10 sm:px-6 lg:px-8">
      <nav class="mb-6 flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-brand-600 dark:hover:text-brand-300">Home</a>
        <span>/</span>
        <a href="/reviews" class="hover:text-brand-600 dark:hover:text-brand-300">Reviews</a>
        <span>/</span>
        <span class="text-ink-800 dark:text-slate-200">{toolName}</span>
      </nav>

      <span class="chip">{category}</span>
      <h1 class="mt-4 font-display text-3xl font-bold leading-tight text-ink-900 sm:text-4xl dark:text-white">
        {title}
      </h1>
      <p class="mt-4 text-lg text-slate-600 dark:text-slate-400">{description}</p>

      {landingStyle && launchBanner && (
        <div class="mt-6 rounded-xl border border-amber-300 bg-amber-50 px-4 py-3 text-sm font-medium text-amber-800 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-300">
          {launchBanner}
        </div>
      )}

      <div class="mt-6 flex flex-wrap items-center gap-4 text-sm">
        <span class="chip">{pricing}</span>
        <time datetime={pubDate.toISOString()} class="text-slate-500 dark:text-slate-500">
          Updated {(updatedDate ?? pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
      </div>

      {landingStyle && (
        <div class="mt-6">
          <a href={websiteUrl} target="_blank" rel="noopener noreferrer nofollow sponsored" class="btn-primary inline-flex">
            {cta} →
          </a>
        </div>
      )}

      {heroImage && (
        <Image
          src={heroImage}
          alt={heroImageAlt ?? title}
          width={900}
          height={506}
          class="mt-8 w-full rounded-2xl object-cover shadow-lg"
        />
      )}

      {screenshots.length > 0 && (
        <div class="mt-10">
          <h2 class="font-display text-sm font-semibold uppercase tracking-wide text-ink-900 dark:text-white">Product Screenshots</h2>
          <p class="mt-1 text-xs text-slate-500 dark:text-slate-500">Click any screenshot to view it full-size.</p>
          <div class="mt-4 grid gap-5 sm:grid-cols-2">
            {screenshots.map((shot, i) => (
              <figure class="overflow-hidden rounded-2xl border border-slate-200/70 bg-white shadow-md transition-shadow hover:shadow-xl dark:border-white/10 dark:bg-ink-900">
                <button
                  type="button"
                  class="js-lightbox-trigger block w-full cursor-zoom-in"
                  data-full={screenshotFulls[i]}
                  data-alt={shot.caption ?? `${toolName} screenshot`}
                  aria-label={`Enlarge screenshot: ${shot.caption ?? toolName}`}
                >
                  <Image
                    src={shot.image}
                    alt={shot.caption ?? `${toolName} screenshot`}
                    width={640}
                    height={Math.round((640 / (shot.image.width ?? 1920)) * (shot.image.height ?? 964))}
                    class="w-full object-cover"
                  />
                </button>
                {shot.caption && (
                  <figcaption class="border-t border-slate-200/70 px-4 py-3 text-sm text-slate-600 dark:border-white/10 dark:text-slate-400">
                    {shot.caption}
                  </figcaption>
                )}
              </figure>
            ))}
          </div>
        </div>
      )}
    </div>

    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="glass-card p-5">
          <h2 class="font-display text-sm font-semibold uppercase tracking-wide text-emerald-600 dark:text-emerald-400">Pros</h2>
          <ul class="mt-3 space-y-2 text-sm text-slate-700 dark:text-slate-300">
            {pros.map((pro) => (
              <li class="flex gap-2">
                <span class="mt-0.5 text-emerald-500">✓</span>
                <span>{pro}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="glass-card p-5">
          <h2 class="font-display text-sm font-semibold uppercase tracking-wide text-rose-600 dark:text-rose-400">Cons</h2>
          <ul class="mt-3 space-y-2 text-sm text-slate-700 dark:text-slate-300">
            {cons.map((con) => (
              <li class="flex gap-2">
                <span class="mt-0.5 text-rose-500">✕</span>
                <span>{con}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      {landingStyle && pricingTiers.length > 0 && (
        <div class="mt-10">
          <h2 class="font-display text-sm font-semibold uppercase tracking-wide text-ink-900 dark:text-white">Pricing Plans</h2>
          <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {pricingTiers.map((tier) => (
              <div class="glass-card flex flex-col gap-3 p-5">
                <p class="font-display font-semibold text-ink-900 dark:text-white">{tier.name}</p>
                <p class="text-2xl font-bold text-brand-600 dark:text-brand-300">{tier.price}</p>
                <a href={websiteUrl} target="_blank" rel="noopener noreferrer nofollow sponsored" class="btn-secondary mt-auto text-center">
                  Get {tier.name}
                </a>
              </div>
            ))}
          </div>
        </div>
      )}

      <div class="prose prose-slate mt-10 max-w-none prose-headings:font-display prose-headings:font-semibold prose-a:text-brand-600 dark:prose-invert dark:prose-a:text-brand-300">
        <slot />
      </div>

      <div class="my-12 flex flex-col items-center justify-between gap-4 rounded-2xl border border-brand-200 bg-gradient-to-r from-brand-50 to-accent-50 p-6 sm:flex-row dark:border-brand-500/30 dark:from-brand-950/40 dark:to-ink-800">
        <div>
          <p class="font-display text-lg font-semibold text-ink-900 dark:text-white">Ready to try {toolName}?</p>
          <p class="text-sm text-slate-600 dark:text-slate-400">Visit the official site to explore plans and get started.</p>
        </div>
        <a href={websiteUrl} target="_blank" rel="noopener noreferrer nofollow sponsored" class="btn-primary whitespace-nowrap">
          {cta}
        </a>
      </div>

      {tags.length > 0 && (
        <div class="mb-16 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span class="chip">#{tag}</span>
          ))}
        </div>
      )}
    </div>
  </article>

  {screenshots.length > 0 && (
    <div
      id="screenshot-lightbox"
      class="hidden fixed inset-0 z-50 items-center justify-center bg-black/90 p-4"
    >
      <button
        id="screenshot-lightbox-close"
        type="button"
        aria-label="Close"
        class="absolute right-4 top-4 flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-2xl text-white hover:bg-white/20"
      >
        &times;
      </button>
      <img id="screenshot-lightbox-img" src="" alt="" class="max-h-[90vh] max-w-full rounded-xl object-contain shadow-2xl" />
    </div>
  )}

  <script>
    const lightbox = document.getElementById('screenshot-lightbox');
    const lightboxImg = document.getElementById('screenshot-lightbox-img');
    const closeBtn = document.getElementById('screenshot-lightbox-close');

    function openLightbox(src, alt) {
      if (!lightbox || !lightboxImg) return;
      lightboxImg.setAttribute('src', src);
      lightboxImg.setAttribute('alt', alt);
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      if (!lightbox || !lightboxImg) return;
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      lightboxImg.setAttribute('src', '');
      document.body.style.overflow = '';
    }

    document.querySelectorAll('.js-lightbox-trigger').forEach((el) => {
      el.addEventListener('click', () => {
        const full = el.getAttribute('data-full');
        const alt = el.getAttribute('data-alt') ?? '';
        if (full) openLightbox(full, alt);
      });
    });

    closeBtn?.addEventListener('click', closeLightbox);
    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeLightbox();
    });
  </script>
</BaseLayout>
