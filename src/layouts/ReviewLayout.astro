---
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import RatingStars from '../components/RatingStars.astro';
import { SITE_URL } from '../consts';

interface Props {
  entry: {
    id: string;
    data: {
      title: string;
      description: string;
      toolName: string;
      category: string;
      rating: number;
      pricing: string;
      websiteUrl: string;
      pubDate: Date;
      updatedDate?: Date;
      heroImage?: any;
      pros: string[];
      cons: string[];
      tags: string[];
    };
  };
}

const { entry } = Astro.props;
const { title, description, toolName, category, rating, pricing, websiteUrl, pubDate, updatedDate, heroImage, pros, cons, tags } = entry.data;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Review',
  itemReviewed: {
    '@type': 'SoftwareApplication',
    name: toolName,
    applicationCategory: category,
    url: websiteUrl,
  },
  author: {
    '@type': 'Organization',
    name: 'AppScoutHub',
  },
  reviewRating: {
    '@type': 'Rating',
    ratingValue: rating,
    bestRating: 5,
    worstRating: 0,
  },
  datePublished: pubDate.toISOString(),
  ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
  publisher: {
    '@type': 'Organization',
    name: 'AppScoutHub',
    url: SITE_URL,
  },
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'Reviews', item: `${SITE_URL}/reviews` },
    { '@type': 'ListItem', position: 3, name: title, item: `${SITE_URL}/reviews/${entry.id}` },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  jsonLd={[jsonLd, breadcrumbJsonLd]}
>
  <article class="bg-grid dark:bg-none">
    <div class="mx-auto max-w-3xl px-4 pb-4 pt-10 sm:px-6 lg:px-8">
      <nav class="mb-6 flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-brand-600 dark:hover:text-brand-300">Home</a>
        <span>/</span>
        <a href="/reviews" class="hover:text-brand-600 dark:hover:text-brand-300">Reviews</a>
        <span>/</span>
        <span class="text-ink-800 dark:text-slate-200">{toolName}</span>
      </nav>

      <span class="chip">{category}</span>
      <h1 class="mt-4 font-display text-3xl font-bold leading-tight text-ink-900 sm:text-4xl dark:text-white">
        {title}
      </h1>
      <p class="mt-4 text-lg text-slate-600 dark:text-slate-400">{description}</p>

      <div class="mt-6 flex flex-wrap items-center gap-4 text-sm">
        <RatingStars rating={rating} size="md" />
        <span class="chip">{pricing}</span>
        <time datetime={pubDate.toISOString()} class="text-slate-500 dark:text-slate-500">
          Updated {(updatedDate ?? pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
      </div>

      {heroImage && (
        <Image
          src={heroImage}
          alt={title}
          width={900}
          height={506}
          class="mt-8 w-full rounded-2xl object-cover shadow-lg"
        />
      )}
    </div>

    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="glass-card p-5">
          <h2 class="font-display text-sm font-semibold uppercase tracking-wide text-emerald-600 dark:text-emerald-400">Pros</h2>
          <ul class="mt-3 space-y-2 text-sm text-slate-700 dark:text-slate-300">
            {pros.map((pro) => (
              <li class="flex gap-2">
                <span class="mt-0.5 text-emerald-500">✓</span>
                <span>{pro}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="glass-card p-5">
          <h2 class="font-display text-sm font-semibold uppercase tracking-wide text-rose-600 dark:text-rose-400">Cons</h2>
          <ul class="mt-3 space-y-2 text-sm text-slate-700 dark:text-slate-300">
            {cons.map((con) => (
              <li class="flex gap-2">
                <span class="mt-0.5 text-rose-500">✕</span>
                <span>{con}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="prose prose-slate mt-10 max-w-none prose-headings:font-display prose-headings:font-semibold prose-a:text-brand-600 dark:prose-invert dark:prose-a:text-brand-300">
        <slot />
      </div>

      <div class="my-12 flex flex-col items-center justify-between gap-4 rounded-2xl border border-brand-200 bg-gradient-to-r from-brand-50 to-accent-50 p-6 sm:flex-row dark:border-brand-500/30 dark:from-brand-950/40 dark:to-ink-800">
        <div>
          <p class="font-display text-lg font-semibold text-ink-900 dark:text-white">Ready to try {toolName}?</p>
          <p class="text-sm text-slate-600 dark:text-slate-400">Visit the official site to explore plans and get started.</p>
        </div>
        <a href={websiteUrl} target="_blank" rel="noopener noreferrer nofollow sponsored" class="btn-primary whitespace-nowrap">
          Visit {toolName}
        </a>
      </div>

      {tags.length > 0 && (
        <div class="mb-16 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span class="chip">#{tag}</span>
          ))}
        </div>
      )}
    </div>
  </article>
</BaseLayout>
