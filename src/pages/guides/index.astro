---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideCard from '../../components/GuideCard.astro';

const allGuides = (await getCollection('guides', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="AI Guides"
  description="Practical guides on how to use AI tools for freelancing, agencies, and everyday productivity — no fluff, just workflows that work."
>
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <h1 class="font-display text-3xl font-bold text-ink-900 sm:text-4xl dark:text-white">Guides</h1>
      <p class="mt-3 text-slate-600 dark:text-slate-400">
        {allGuides.length} practical guide{allGuides.length === 1 ? '' : 's'} on using AI tools effectively.
      </p>
    </div>

    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {allGuides.map((entry) => <GuideCard entry={entry} />)}
    </div>
  </section>
</BaseLayout>
