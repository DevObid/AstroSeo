---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ReviewCard from '../components/ReviewCard.astro';
import { SITE_URL } from '../consts';

const allReviews = (await getCollection('reviews', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const featured = allReviews.filter((r) => r.data.featured).slice(0, 1)[0] ?? allReviews[0];
const latest = allReviews.filter((r) => r.id !== featured?.id).slice(0, 6);

const categories = [
  { name: 'Writing', icon: '✍️' },
  { name: 'Image Generation', icon: '🎨' },
  { name: 'Coding', icon: '💻' },
  { name: 'Video', icon: '🎬' },
  { name: 'Productivity', icon: '⚡' },
  { name: 'Chatbots', icon: '💬' },
  { name: 'Audio', icon: '🎙️' },
  { name: 'Marketing', icon: '📈' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'AppScoutHub',
  url: SITE_URL,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${SITE_URL}/reviews?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
---

<BaseLayout jsonLd={jsonLd}>
  <section class="relative overflow-hidden bg-grid dark:bg-none">
    <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[600px] bg-gradient-to-b from-brand-100/60 via-transparent to-transparent dark:from-brand-900/30"></div>
    <div class="mx-auto max-w-6xl px-4 py-20 text-center sm:px-6 sm:py-28 lg:px-8">
      <span class="chip mx-auto animate-fade-up bg-white/80 dark:bg-white/5">
        🔥 {allReviews.length}+ AI tools reviewed and counting
      </span>
      <h1 class="mx-auto mt-6 max-w-3xl animate-fade-up font-display text-4xl font-bold leading-tight text-ink-900 sm:text-6xl dark:text-white">
        Find the <span class="text-gradient">right AI tool</span> without the guesswork
      </h1>
      <p class="mx-auto mt-6 max-w-2xl animate-fade-up text-lg text-slate-600 dark:text-slate-400">
        Honest, hands-on reviews of the best AI tools and software for writing, coding, design, video, and productivity — no fluff, no sponsored hype.
      </p>
      <div class="mt-8 flex animate-fade-up flex-wrap items-center justify-center gap-4">
        <a href="/reviews" class="btn-primary">Browse all reviews</a>
        <a href="/categories" class="btn-secondary">Explore categories</a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-center justify-center gap-3">
      {categories.map((cat) => (
        <a
          href={`/categories/${cat.name.toLowerCase().replace(/\s+/g, '-')}`}
          class="chip bg-white text-sm hover:border-brand-400 hover:text-brand-600 dark:bg-white/5 dark:hover:text-brand-300"
        >
          <span>{cat.icon}</span>
          {cat.name}
        </a>
      ))}
    </div>
  </section>

  {featured && (
    <section class="mx-auto max-w-6xl px-4 py-6 sm:px-6 lg:px-8">
      <h2 class="mb-6 font-display text-2xl font-bold text-ink-900 dark:text-white">Editor's pick</h2>
      <ReviewCard entry={featured} featured />
    </section>
  )}

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="mb-6 flex items-end justify-between">
      <h2 class="font-display text-2xl font-bold text-ink-900 dark:text-white">Latest reviews</h2>
      <a href="/reviews" class="text-sm font-semibold text-brand-600 hover:underline dark:text-brand-300">View all →</a>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {latest.map((entry) => <ReviewCard entry={entry} />)}
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="glass-card flex flex-col items-center gap-4 p-10 text-center">
      <h2 class="font-display text-2xl font-bold text-ink-900 dark:text-white">Never miss a new review</h2>
      <p class="max-w-md text-slate-600 dark:text-slate-400">
        Get new AI tool reviews delivered straight to your inbox. No spam, unsubscribe any time.
      </p>
      <form class="flex w-full max-w-md flex-col gap-3 sm:flex-row" onsubmit="event.preventDefault()">
        <input
          type="email"
          required
          placeholder="you@example.com"
          class="flex-1 rounded-full border border-slate-300 bg-white px-5 py-3 text-sm text-ink-900 outline-none focus:border-brand-500 dark:border-white/15 dark:bg-white/5 dark:text-white"
        />
        <button type="submit" class="btn-primary whitespace-nowrap">Subscribe</button>
      </form>
    </div>
  </section>
</BaseLayout>
