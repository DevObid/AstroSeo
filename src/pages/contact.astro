---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Us"
  description="Get in touch with the AppScoutHub team — questions, tool suggestions, corrections, or partnership inquiries."
>
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <h1 class="font-display text-3xl font-bold text-ink-900 sm:text-4xl dark:text-white">Contact Us</h1>
    <p class="mt-4 max-w-2xl text-slate-600 dark:text-slate-400">
      Have a question, a tool suggestion, or spotted something that needs fixing in a review? Send us a message and
      we'll get back to you as soon as we can.
    </p>

    <div class="mt-10 grid gap-8 sm:grid-cols-2">
      <form
        class="glass-card flex flex-col gap-4 p-6"
        action="https://formsubmit.co/contact@appscouthub.com"
        method="POST"
      >
        <input type="hidden" name="_subject" value="New message from AppScoutHub Contact form" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_next" value="https://appscouthub.com/contact" />
        <div>
          <label for="name" class="mb-1 block text-sm font-medium text-ink-800 dark:text-slate-200">Name</label>
          <input
            id="name"
            name="name"
            type="text"
            required
            class="w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm text-ink-900 outline-none focus:border-brand-500 dark:border-white/15 dark:bg-white/5 dark:text-white"
          />
        </div>
        <div>
          <label for="email" class="mb-1 block text-sm font-medium text-ink-800 dark:text-slate-200">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            class="w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm text-ink-900 outline-none focus:border-brand-500 dark:border-white/15 dark:bg-white/5 dark:text-white"
          />
        </div>
        <div>
          <label for="subject" class="mb-1 block text-sm font-medium text-ink-800 dark:text-slate-200">Subject</label>
          <input
            id="subject"
            name="subject"
            type="text"
            class="w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm text-ink-900 outline-none focus:border-brand-500 dark:border-white/15 dark:bg-white/5 dark:text-white"
          />
        </div>
        <div>
          <label for="message" class="mb-1 block text-sm font-medium text-ink-800 dark:text-slate-200">Message</label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            class="w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm text-ink-900 outline-none focus:border-brand-500 dark:border-white/15 dark:bg-white/5 dark:text-white"
          ></textarea>
        </div>
        <button type="submit" class="btn-primary w-full">Send message</button>
      </form>

      <div class="glass-card flex flex-col gap-4 p-6">
        <div>
          <h2 class="font-display text-sm font-semibold uppercase tracking-wide text-ink-900 dark:text-white">Email</h2>
          <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
            <a href="mailto:contact@appscouthub.com" class="text-brand-600 hover:underline dark:text-brand-300">contact@appscouthub.com</a>
          </p>
        </div>
        <div>
          <h2 class="font-display text-sm font-semibold uppercase tracking-wide text-ink-900 dark:text-white">Tool suggestions</h2>
          <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
            Know an AI tool we should review? Tell us about it and we'll add it to our queue.
          </p>
        </div>
        <div>
          <h2 class="font-display text-sm font-semibold uppercase tracking-wide text-ink-900 dark:text-white">Response time</h2>
          <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">We typically reply within 2–3 business days.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
