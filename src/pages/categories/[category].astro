---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReviewCard from '../../components/ReviewCard.astro';

export async function getStaticPaths() {
  const allReviews = await getCollection('reviews', ({ data }) => !data.draft);
  const categories = [...new Set(allReviews.map((r) => r.data.category))];

  return categories.map((category) => ({
    params: { category: category.toLowerCase().replace(/\s+/g, '-') },
    props: {
      category,
      reviews: allReviews
        .filter((r) => r.data.category === category)
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { category, reviews } = Astro.props;
---

<BaseLayout
  title={`${category} AI Tools`}
  description={`Reviews of the best ${category} AI tools and software, tested hands-on for quality, pricing, and real-world usefulness.`}
>
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
    <nav class="mb-4 text-sm text-slate-500 dark:text-slate-400">
      <a href="/categories" class="hover:text-brand-600 dark:hover:text-brand-300">Categories</a>
      <span> / </span>
      <span class="text-ink-800 dark:text-slate-200">{category}</span>
    </nav>
    <h1 class="font-display text-3xl font-bold text-ink-900 sm:text-4xl dark:text-white">{category} AI Tools</h1>
    <p class="mt-3 text-slate-600 dark:text-slate-400">{reviews.length} review{reviews.length === 1 ? '' : 's'} in this category.</p>

    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {reviews.map((entry) => <ReviewCard entry={entry} />)}
    </div>
  </section>
</BaseLayout>
