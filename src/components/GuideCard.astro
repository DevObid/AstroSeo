---
import { Image } from 'astro:assets';

interface Props {
  entry: {
    id: string;
    data: {
      title: string;
      description: string;
      category: string;
      heroImage?: any;
      heroImageAlt?: string;
      pubDate: Date;
    };
  };
  featured?: boolean;
}

const { entry, featured = false } = Astro.props;
const { title, description, category, heroImage, heroImageAlt, pubDate } = entry.data;
const href = `/guides/${entry.id}`;
---

<a href={href} class:list={['glass-card group flex flex-col', featured ? 'md:flex-row' : '']}>
  <div class:list={['relative aspect-[16/9] w-full overflow-hidden bg-gradient-to-br from-brand-100 to-accent-100 dark:from-ink-800 dark:to-ink-700', featured ? 'md:w-2/5 md:aspect-auto' : '']}>
    {heroImage ? (
      <Image
        src={heroImage}
        alt={heroImageAlt ?? title}
        width={640}
        height={360}
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
    ) : (
      <div class="flex h-full w-full items-center justify-center font-display text-2xl font-bold text-brand-500/40">
        {category}
      </div>
    )}
    <span class="absolute left-3 top-3 chip bg-white/90 dark:bg-ink-950/80">{category}</span>
  </div>

  <div class="flex flex-1 flex-col gap-3 p-5">
    <h3 class="font-display text-lg font-semibold leading-snug text-ink-900 group-hover:text-brand-600 dark:text-white dark:group-hover:text-brand-300">
      {title}
    </h3>
    <p class="line-clamp-2 text-sm text-slate-600 dark:text-slate-400">{description}</p>
    <div class="mt-auto flex items-center justify-between pt-2 text-xs text-slate-500 dark:text-slate-500">
      <time datetime={pubDate.toISOString()}>
        {pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
      </time>
      <span class="font-semibold text-brand-600 group-hover:underline dark:text-brand-300">Read guide →</span>
    </div>
  </div>
</a>
