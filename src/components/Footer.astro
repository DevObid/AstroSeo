---
import { SITE_TITLE } from '../consts';

const year = new Date().getFullYear();

const categories = [
  'Writing',
  'Image Generation',
  'Coding',
  'Video',
  'Productivity',
  'Chatbots',
];
---

<footer class="border-t border-slate-200/70 bg-slate-50/60 dark:border-white/10 dark:bg-ink-900/40">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-5">
      <div class="md:col-span-2">
        <a href="/" class="flex items-center gap-2 font-display text-lg font-bold">
          <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-brand-600 to-accent-400 text-white">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-5 w-5">
              <path d="M12 2l2.4 6.6L21 11l-6.6 2.4L12 20l-2.4-6.6L3 11l6.6-2.4L12 2z" fill="currentColor" />
            </svg>
          </span>
          <span>{SITE_TITLE}</span>
        </a>
        <p class="mt-4 max-w-sm text-sm text-slate-600 dark:text-slate-400">
          Honest, hands-on reviews of the AI tools and software actually worth your time and money.
        </p>
      </div>

      <div>
        <h3 class="font-display text-sm font-semibold uppercase tracking-wide text-ink-900 dark:text-white">Categories</h3>
        <ul class="mt-4 space-y-2 text-sm text-slate-600 dark:text-slate-400">
          {categories.map((cat) => (
            <li>
              <a href={`/categories/${cat.toLowerCase().replace(/\s+/g, '-')}`} class="hover:text-brand-600 dark:hover:text-brand-300">
                {cat}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="font-display text-sm font-semibold uppercase tracking-wide text-ink-900 dark:text-white">Site</h3>
        <ul class="mt-4 space-y-2 text-sm text-slate-600 dark:text-slate-400">
          <li><a href="/reviews" class="hover:text-brand-600 dark:hover:text-brand-300">All Reviews</a></li>
          <li><a href="/guides" class="hover:text-brand-600 dark:hover:text-brand-300">Guides</a></li>
          <li><a href="/about" class="hover:text-brand-600 dark:hover:text-brand-300">About</a></li>
          <li><a href="/contact" class="hover:text-brand-600 dark:hover:text-brand-300">Contact Us</a></li>
          <li><a href="/rss.xml" class="hover:text-brand-600 dark:hover:text-brand-300">RSS Feed</a></li>
        </ul>
      </div>

      <div>
        <h3 class="font-display text-sm font-semibold uppercase tracking-wide text-ink-900 dark:text-white">Legal</h3>
        <ul class="mt-4 space-y-2 text-sm text-slate-600 dark:text-slate-400">
          <li><a href="/privacy-policy" class="hover:text-brand-600 dark:hover:text-brand-300">Privacy Policy</a></li>
          <li><a href="/terms-of-service" class="hover:text-brand-600 dark:hover:text-brand-300">Terms of Service</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-slate-200/70 pt-6 text-sm text-slate-500 sm:flex-row dark:border-white/10 dark:text-slate-500">
      <p>&copy; {year} {SITE_TITLE}. All rights reserved.</p>
      <div class="flex items-center gap-4">
        <a href="/privacy-policy" class="hover:text-brand-600 dark:hover:text-brand-300">Privacy Policy</a>
        <a href="/terms-of-service" class="hover:text-brand-600 dark:hover:text-brand-300">Terms of Service</a>
        <span>Built with Astro.</span>
      </div>
    </div>
  </div>
</footer>
